    "test:browser": "node tests/browser-smoke.mjs",
    "test:ai:shared": "node --import tsx tests/ai-multiprocess.mts"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@pdf-lib/fontkit": "^1.1.1",
