    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.65.1",
    "tsx": "^4.17.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
