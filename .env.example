SESSION_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGIN=http://localhost:5173
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_BASE_URL=
VITE_API_PORT=3001
AI_REQUESTS_PER_MINUTE=12
# Shared application limit: set at or below the provider project RPM quota
AI_GLOBAL_REQUESTS_PER_MINUTE=20
AI_MAX_CONCURRENCY=2
AI_QUEUE_TIMEOUT_MS=10000
AI_REQUEST_TIMEOUT_MS=25000
AI_MAX_ATTEMPTS=3
# Production PostgreSQL pooled connection; run ALL migrations/001..003 first
DATABASE_URL=

